# ============================================
# CatalogIQ — Environment Configuration Template
# ============================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-pip-2024

# Database (Zero-Docker SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./data/product_intelligence.db
DATABASE_ECHO=false

# Google Gemini AI Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash

# Mock AI (set to false when GEMINI_API_KEY is provided)
USE_MOCK_AI=false

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff,xlsx,csv,docx,txt

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
